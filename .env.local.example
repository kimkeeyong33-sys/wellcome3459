# Supabase 프로젝트 설정 (Supabase 대시보드 > Project Settings > API 에서 확인)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # 서버 전용, 절대 공개 저장소에 커밋하지 마세요

# 결제 연동 (토스페이먼츠) - 비워두면 "고객 결제 받기" 발행이 데모 결제로 동작합니다
# 발급: https://developers.tosspayments.com 가입 → 상점 개설(무료) → 연동 키 확인
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 사업자등록 진위확인 (공공데이터포털 - 국세청 API) - 비워두면 사업자등록 인증을 건너뜁니다
# 발급: https://www.data.go.kr → "국세청_사업자등록정보 진위확인 및 상태조회 서비스" 활용신청 (무료)
BIZNO_API_KEY=

# SEO/사이트맵용 실제 배포 주소 (커스텀 도메인 연결 후 그 주소로 바꿔주세요)
NEXT_PUBLIC_SITE_URL=https://cashticket.vercel.app
