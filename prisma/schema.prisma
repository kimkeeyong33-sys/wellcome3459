// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum AuctionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
}

model Company {
  id                 String   @id @default(cuid())
  name               String
  registrationNumber String   @unique
  verified           Boolean  @default(false)
  users              User[]
  createdAt          DateTime @default(now())
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         UserRole  @default(BUYER)
  company      Company?  @relation(fields: [companyId], references: [id])
  companyId    String?
  auctions     Auction[] @relation("SellerAuctions")
  wonAuctions  Auction[] @relation("WinnerAuctions")
  bids         Bid[]
  createdAt    DateTime  @default(now())
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  auctions Auction[]
}

model Auction {
  id           String        @id @default(cuid())
  title        String
  description  String
  images       String[]      @default([])
  category     Category?     @relation(fields: [categoryId], references: [id])
  categoryId   String?
  seller       User          @relation("SellerAuctions", fields: [sellerId], references: [id])
  sellerId     String
  startPrice   Decimal       @db.Decimal(14, 2)
  currentPrice Decimal       @db.Decimal(14, 2)
  minIncrement Decimal       @default(1000) @db.Decimal(14, 2)
  buyNowPrice  Decimal?      @db.Decimal(14, 2)
  quantity     Int           @default(1)
  unit         String        @default("개")
  startAt      DateTime
  endAt        DateTime
  status       AuctionStatus @default(SCHEDULED)
  winner       User?         @relation("WinnerAuctions", fields: [winnerId], references: [id])
  winnerId     String?
  bids         Bid[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, endAt])
}

model Bid {
  id        String   @id @default(cuid())
  auction   Auction  @relation(fields: [auctionId], references: [id])
  auctionId String
  bidder    User     @relation(fields: [bidderId], references: [id])
  bidderId  String
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  @@index([auctionId, amount])
}
